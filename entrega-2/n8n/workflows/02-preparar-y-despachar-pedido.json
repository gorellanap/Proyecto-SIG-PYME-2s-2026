    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT p.id_pedido,\n       p.estado_pedido,\n       ROUND(TIMESTAMPDIFF(HOUR, p.fecha_compra, COALESCE(d.fecha_entrega_transporte, NOW())) / 24.0, 1) AS dias_desde_compra,\n       TIMESTAMPDIFF(HOUR, p.fecha_compra, COALESCE(d.fecha_entrega_transporte, NOW())) <= 48 AS dentro_de_meta\nFROM pedido p\nLEFT JOIN despacho d ON d.id_pedido = p.id_pedido\nWHERE p.id_pedido = {{ Math.trunc(Number($('Formulario de bodega').first().json['N° de pedido'])) || 0 }};",
        "options": {}
      },
