      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const sqlTexto = (v) => {\n  const t = String(v ?? '').trim();\n  return t === '' ? 'NULL' : \"'\" + t.replace(/\\\\/g, '\\\\\\\\').replace(/'/g, \"\\\\'\") + \"'\";\n};\nconst f = $('Formulario de bodega').first().json;\nreturn {\n  json: {\n    empresa_transporte: sqlTexto(f['Empresa de transporte']),\n    codigo_seguimiento: sqlTexto(f['Código de seguimiento']),\n  },\n};\n"
      },
      "id": "3b2ff382-6b19-52d3-b841-b6cee8b19fa0",
