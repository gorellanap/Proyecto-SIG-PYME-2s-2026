    {
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO despacho (id_pedido, fecha_preparacion, fecha_entrega_transporte, empresa_transporte, codigo_seguimiento)\nVALUES ({{ Math.trunc(Number($('Formulario de bodega').first().json['N° de pedido'])) || 0 }}, NOW(), NOW(), {{ $json.empresa_transporte }}, {{ $json.codigo_seguimiento }}) AS nuevo\nON DUPLICATE KEY UPDATE\n  fecha_preparacion = COALESCE(despacho.fecha_preparacion, nuevo.fecha_preparacion),\n  fecha_entrega_transporte = nuevo.fecha_entrega_transporte,\n  empresa_transporte = nuevo.empresa_transporte,\n  codigo_seguimiento = nuevo.codigo_seguimiento;",
